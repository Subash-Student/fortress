{
  "expo": {
    "name": "Fortress",
    "slug": "vault-password-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fortress_logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "vaultapp",
    "ios": {
      "bundleIdentifier": "com.anonymous.vaultpasswordmanager",
      "supportsTablet": false,
      "icon": "./assets/fortress_logo_ios.png",
      "infoPlist": {
        "CFBundleDisplayName": "Fortress",
        "NSFaceIDUsageDescription": "Fortress uses Face ID to unlock your password vault."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/fortress_logo.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS"
      ],
      "package": "com.anonymous.vaultpasswordmanager"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/fortress_logo.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fortress uses Face ID to unlock your password vault."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
