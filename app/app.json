{
  "expo": {
    "name": "Vault",
    "slug": "vault-password-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vaultapp",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.vaultpasswordmanager",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vault uses Face ID to unlock your password vault."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Vault uses Face ID to unlock your password vault."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
